# EdgeQuake API Dockerfile - Simplified build without cargo-chef
# Multi-stage build for production-optimized Rust application with PostgreSQL support
# Build context should be /Users/raphaelmansuy/Github/03-working (parent of edgequake/)

# ============================================
# Stage 1: Builder - Build application
# ============================================
FROM rust:bookworm AS builder

WORKDIR /workspace

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy edgequake directory
COPY edgequake ./edgequake

# Change to edgequake directory for build
WORKDIR /workspace/edgequake/edgequake

# Debug: Show directory structure
RUN echo "Current directory:" && pwd && echo "Contents:" && ls -la && echo "Cargo.toml check:" && cat Cargo.toml | head -20

# Remove invalid benchmark references to avoid build errors
RUN sed -i '/\[\[bench\]\]/,/^$/d' Cargo.toml || true

# Build the application (explicitly specify binary)
RUN cargo build --release --bin edgequake

# Debug: Find where the binary was built
RUN echo "=== Searching for edgequake binary ===" && \
    find /workspace -name "edgequake" -type f -executable 2>/dev/null || echo "Binary not found" && \
    echo "=== Contents of /workspace/edgequake/ ===" && ls -la /workspace/edgequake/ && \
    echo "=== Contents of current dir target/ ===" && ls -la target/ 2>/dev/null || echo "No target in current dir"

# Strip the binary to reduce size (using found location)
RUN BINARY_PATH=$(find /workspace -name "edgequake" -type f -executable 2>/dev/null | head -1) && \
    if [ -n "$BINARY_PATH" ]; then strip "$BINARY_PATH" || true; echo "Stripped: $BINARY_PATH"; fi

# ============================================
# Stage 2: Runtime - Minimal runtime image
# ============================================
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -s /bin/false -u 1001 edgequake

# Copy binary from builder (note: binary is at workspace root target/)
COPY --from=builder /workspace/edgequake/target/release/edgequake /app/edgequake

# Change ownership
RUN chown -R edgequake:edgequake /app

# Switch to non-root user
USER edgequake

# Expose port (adjust based on your app)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["/app/edgequake"]
