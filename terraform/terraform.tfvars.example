# Example terraform.tfvars file
# Copy this to terraform.tfvars and update with your values

project_id = "saas-app-001"
region     = "us-central1"
environment = "dev"
app_name   = "edgequake"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Database VM Configuration
db_vm_machine_type = "e2-standard-2"
db_vm_boot_disk_size = 50
db_port = 5432
postgresql_version = "16"

# Cloud Run Configuration
nextjs_service_name  = "nextjs-frontend"
rust_api_service_name = "rust-api"
cloud_run_memory = "512Mi"
cloud_run_cpu = "0.25"
cloud_run_min_instances = 0
cloud_run_max_instances = 10

# Container Images (update after building and pushing)
nextjs_image_url = ""  # Fill after building: gcr.io/PROJECT/nextjs:latest
rust_api_image_url = ""  # Fill after building: gcr.io/PROJECT/rust-api:latest

# Networking
enable_direct_vpc_egress = true  # Recommended: use Direct VPC egress instead of VPC connectors

# Backups (WAL archiving to GCS)
enable_wal_archiving = false  # Set to true for production backups; requires gcs_backup_bucket
gcs_backup_bucket = ""  # Optional: Create a GCS bucket and set here if enable_wal_archiving = true

# Data disk configuration
create_data_disk = true
# Protect the data disk from accidental deletion
data_disk_prevent_destroy = true
# Data disk size (GB)
data_disk_size = 50
# Data disk type (pd-standard, pd-ssd, pd-balanced)
data_disk_type = "pd-standard"
# Snapshot schedule and retention
enable_snapshot_schedule = true
snapshot_retention_days = 3
snapshot_start_time = "04:00"

# Labels
labels = {
  "managed_by" = "terraform"
  "env"        = "dev"
  "app"        = "edgequake"
  "team"       = "platform"
}
